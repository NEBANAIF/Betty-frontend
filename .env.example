# Backend API base URL. Leave unset for same-origin '/api' (e.g. behind
# nginx/Netlify redirects proxying /api to the backend). Set to an absolute
# URL (e.g. https://your-backend.onrender.com) when the frontend and backend
# are on different hosts, such as Netlify (frontend) + Render (backend).
# VITE_API_BASE_URL=https://your-backend.onrender.com

# The app's display name, shown on the login screen, sidebar and browser
# tab. Leave unset to keep the default "ERP Suite". Set this per deployment
# to brand it for a specific client without touching any code, e.g.:
# VITE_APP_NAME=Betty Cosmetics
